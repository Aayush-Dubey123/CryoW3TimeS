# ─── Whitelist: only track app/ components/ hooks/ lib/ public/ ──────────────
#
# Approach: ignore EVERYTHING at root first, then explicitly un-ignore
# only the five directories we want in the remote repository.
# ─────────────────────────────────────────────────────────────────────────────

# Step 1 — Ignore everything at the repo root
/*

# Step 2 — Keep gitignore and essential Vercel build configs
!.gitignore
!package.json
!package-lock.json
!tsconfig.json
!next.config.js
!tailwind.config.ts
!postcss.config.js
!components.json
!README.md

# Step 3 — Un-ignore application directories
!/app
!/components
!/hooks
!/lib
!/public

