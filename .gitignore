# ─── Whitelist: only track app/ components/ hooks/ lib/ public/ ──────────────
#
# Approach: ignore EVERYTHING at root first, then explicitly un-ignore
# only the five directories we want in the remote repository.
# ─────────────────────────────────────────────────────────────────────────────

# Step 1 — Ignore everything at the repo root
/*

# Step 2 — Always keep .gitignore itself
!.gitignore

# Step 3 — Un-ignore only these five directories
!/app
!/components
!/hooks
!/lib
!/public
